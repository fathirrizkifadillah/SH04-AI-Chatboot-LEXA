# === Environment Mode ===
# development | production
ENVIRONMENT=development

# === Groq API ===
GROQ_API_KEY=gsk_tu_api_key_anda_sini
MODEL_NAME=openai/gpt-oss-120b

# === RAG Pipeline ===
KNOWLEDGE_BASE_DIR=knowledge_base
VECTOR_INDEX_PATH=knowledge_base/vector_index.pkl
KNOWLEDGE_BASE_URL=https://sh-01-company-profile.vercel.app/api/knowledge-base
EMBEDDING_MODEL=all-MiniLM-L6-v2

# === Chat Settings ===
MAX_HISTORY_TURNS=10
RAG_TOP_K=5
RAG_THRESHOLD=0.22
MAX_INPUT_LENGTH=2000

# === API Server ===
API_HOST=0.0.0.0
API_PORT=8000
# Tambahkan domain production atau website yang meng-embed widget (pisahkan dengan koma)
# Contoh: http://localhost:5173,http://localhost:5174,https://lexatech.id,https://admin.lexatech.id
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# === Widget Default ===
WELCOME_MESSAGE=Halo! 👋 Saya Lexa, asisten customer service LEXA Software House. Ada yang bisa saya bantu?

# === Security ===
# Wajib diganti di production: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=lexa-dev-secret-key-change-in-production

# === Admin Default Credentials ===
ADMIN_EMAIL=admin@lexatech.id
# Wajib diisi dengan password unik dan kuat di production.
ADMIN_PASSWORD=

# === Database ===
# Default SQLite lokal: sqlite:///./lexa.db
# Docker: isi semua nilai ini dengan secret yang unik. DATABASE_URL menggunakan host `postgres` di jaringan Compose.
POSTGRES_DB=lexa_db
POSTGRES_USER=lexa_user
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://lexa_user:CHANGE_ME@postgres:5432/lexa_db
