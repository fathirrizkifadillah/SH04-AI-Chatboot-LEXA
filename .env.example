# ============================================
# Environment Variables - Chatbot Lexa
# ============================================
# Salin file ini ke .env dan isi dengan nilai Anda sendiri.
# Jangan pernah commit file .env ke Git!
# ============================================

# [WAJIB] API Key dari Groq Console (https://console.groq.com/)
GROQ_API_KEY=gsk_IsiDenganApiKeyGroqAnda

# [OPSIONAL] URL API basis pengetahuan company profile
# Biarkan kosong untuk menggunakan default
# KNOWLEDGE_BASE_URL=https://sh-01-company-profile.vercel.app/api/knowledge-base

# [OPSIONAL] Keamanan (Ganti di Production!)
# JWT_SECRET=ganti_dengan_kunci_rahasia_anda_yang_kuat
# ADMIN_TOKEN=lexa-admin-secret

# [WAJIB] PostgreSQL Database URL (Sistem kini Wajib menggunakan Postgres)
# Contoh: DATABASE_URL=postgresql://username:password@localhost:5432/lexa_db
# DATABASE_URL=
